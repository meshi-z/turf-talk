rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ヘルパー関数: 管理者権限判定
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email in ['admin@turftalk.example.com']
      );
    }

    // ヘルパー関数: ユーザー進捗データのバリデーション（改ざん防止）
    function isValidProgressData(data) {
      return data.carrotCount is number && data.carrotCount >= 0 && data.carrotCount <= 3
        && data.streakDays is number && data.streakDays >= 0
        && data.learnedCount is number && data.learnedCount >= 0 && data.learnedCount <= 120
        && data.currentHorseWeek is number && data.currentHorseWeek >= 1 && data.currentHorseWeek <= 4
        && (data.progressPercent is number || data.progressPercent is float) && data.progressPercent >= 0.0 && data.progressPercent <= 100.0;
    }

    // ユーザー進捗ドキュメント: 本人のみ読み書き可能（管理者は全件読み取り可能）
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow write: if (request.auth != null && request.auth.uid == userId && isValidProgressData(request.resource.data)) || isAdmin();
    }

    // フレーズマスター: 全員読み取り可能、管理者のみ書き込み可能
    match /phrases/{phraseId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
